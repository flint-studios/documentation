{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Invoke0 Documentation",
  "colors": {
    "primary": "#4ed188",
    "light": "#d8eadd",
    "dark": "#000000"
  },
  "favicon": {
    "light": "/images/BrandLogoDark.svg",
    "dark": "/images/BrandLogoLight.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "products": [
      {
        "product": "Anchor4Git",
        "description": "A highly-minimal workflow tool for small teams.",
        "versions": [
          {
            "version": "0.1.1",
            "default": true,
            "pages": [
              {
                "group": "Getting Started",
                "expanded": true,
                "pages": [
                  "anchor4git/introduction",
                  "anchor4git/quickstart",
                  "anchor4git/installation",
                  "anchor4git/workflow",
                  "anchor4git/troubleshooting"
                ]
              },
              {
                "group": "Commands",
                "pages": [
                  "anchor4git/commands/initialise",
                  "anchor4git/commands/fetch",
                  "anchor4git/commands/save",
                  "anchor4git/commands/info",
                  "anchor4git/commands/upload",
                  "anchor4git/commands/goto",
                  "anchor4git/commands/config"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/BrandLogoDark.svg",
    "dark": "/images/BrandLogoLight.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode",
      "add-mcp",
      "grok",
      "download-pdf",
      "assistant"
    ]
  },
  "icons": {
    "library": "tabler"
  },
  "description": "Official documentation for all Invoke0 products & services.",
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "heading": {
      "family": "Fraunces"
    },
    "body": {
      "family": "Fira Code"
    }
  },
  "thumbnails": {
    "appearance": "dark",
    "fonts": {
      "family": "Fira Code"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true
  },
  "metadata": {
    "timestamp": true
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "interaction": {
    "drilldown": false
  }
}
